# Base URL for the Critiq backend API.
#
# This is a NEXT_PUBLIC_* variable, so its value is inlined into the client
# bundle during `next build` — it is NOT read at runtime. Changing it requires
# rebuilding (locally: `pnpm build`; Docker: rebuild the image). Setting it in
# docker-compose `environment:` has no effect.
#
# Production uses a relative path because the frontend and backend share the
# domain critiq-dev.web.id, so requests stay same-origin (no CORS, and the
# session cookie reaches both).
#
#   production: /api/v1
#   local dev:  http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
